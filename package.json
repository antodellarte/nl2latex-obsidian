{
  "name": "nl2latex-snippets",
  "version": "1.0.0",
  "description": "Motore di conversione da linguaggio naturale a LaTeX. Supporta snippet matematici, tabelle, grafici e altro.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian-plugin",
    "latex",
    "math"
  ],
  "author": "antodellarte",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
